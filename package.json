{
  "name": "studytube",
  "version": "1.0.0",
  "description": "StudyTube - AI-Powered Video Recommendation Platform",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "node server/src/server.js",
